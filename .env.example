# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 轻量 WARP 档案目录（容器内路径，随 /app/data 持久化）
ARTEX_WARP_DIR=/app/data/egress/warp

# 独立代理密钥（Compose 固定挂载独立 proxysecrets 卷；与数据库一起备份）
# 本机直接运行可覆盖此路径；不可指向 jwt.key。
ARTEX_PROXY_SECRETS_FILE=/app/proxy-secrets/key
